                vertex="1" parent="1">
          <mxGeometry x="350" y="280" width="200" height="100"/>
        </mxCell>

        <!-- Layer 2 -->
        <mxCell id="layer2" value="Layer 2:&#xA;- Multi-Head Self-Attention&#xA;- Add &amp; Norm&#xA;- Feed Forward&#xA;- Add &amp; Norm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366"
