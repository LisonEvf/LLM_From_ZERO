<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="Claude" version="21.0.0">
  <diagram id="rope-encoding" name="RoPE旋转位置编码">
    <mxGraphModel dx="1200" dy="800" grid="1" guides="1" to="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="RoPE (Rotary Position Encoding) 原理" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=20;fontStyle=1"
                vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="300" height="30"/>
        </mxCell>

        <!-- Query at position m -->
        <mxCell id="q_m" value="Query&#xA;q_m (位置 m)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf"
                vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="150" height="60"/>
        </mxCell>

        <!-- Key at position n -->
        <mxCell id="k_n" value="Key&#xA;k_n (位置 n)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656"
                vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="150" height="60"/>
        </mxCell>

        <!-- Rotation matrix -->
        <mxCell id="rot_m" value="R(m,&#x3B8;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366"
                vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="120" height="50"/>
        </mxCell>

        <mxCell id="rot_n" value="R(n,&#x3B8;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366"
                vertex="1" parent="1">
          <mxGeometry x="350" y="200" width="120" height="50"/>
        </mxCell>

        <!-- Rotated Q and K -->
        <mxCell id="q_m_rot" value="R(m)·q_m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450"
                vertex="1" parent="1">
          <mxGeometry x="550" y="100" width="120" height="50"/>
        </mxCell>

        <mxCell id="k_n_rot" value="R(n)·k_n" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450"
                vertex="1" parent="1">
          <mxGeometry x="550" y="200" width="120" height="50"/>
        </mxCell>

        <!-- Inner product -->
        <mxCell id="inner" value="内积:&#xA;(R(m)·q) &#xB7; (R(n)·k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6"
                vertex="1" parent="1">
          <mxGeometry x="750" y="100" width="150" height="60"/>
        </mxCell>

        <!-- Arrow to key insight -->
        <mxCell id="arr1" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0"
                edge="1" parent="1" source="q_m_rot" target="inner">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="arr2" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0"
                edge="1" parent="1" source="k_n_rot" target="inner">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Key property box -->
        <mxCell id="key_prop" value="只依赖 (m-n)&#xA;即相对位置！" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1"
                vertex="1" parent="1">
          <mxGeometry x="750" y="200" width="150" height="60"/>
        </mxCell>

        <!-- Arrow inner->key_prop -->
        <mxCell id="arr3" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0"
                edge="1" parent="1" source="inner" target="key_prop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Rotation matrix formula -->
        <mxCell id="rot_formula" value="R(&#x3B8;,m) = [cos(m&#x3B8;) -sin(m&#x3B8;)&#xA;           sin(m&#x3B8;)  cos(m&#x3B8;)]" style="text;html=1;align=left;fontSize=12"
                vertex="1" parent="1">
          <mxGeometry x="350" y="320" width="200" height="50"/>
        </mxCell>

        <!-- Benefits -->
        <mxCell id="benefits" value="优点:&#xA;1. 相对位置编码，外推性好&#xA;2. 不需要额外位置偏置&#xA;3. 可以处理任意长度上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656"
                vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="250" height="100"/>
        </mxCell>

        <!-- Applications -->
        <mxCell id="apps" value="应用:&#xA;- LLaMA&#xA;- GLM&#xA;- DeepSeek" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf"
                vertex="1" parent="1">
          <mxGeometry x="500" y="400" width="200" height="80"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>